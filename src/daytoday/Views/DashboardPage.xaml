<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:daytoday.Views"
             xmlns:dto="clr-namespace:daytoday.Core.DTOs;assembly=daytoday.Core"
             x:DataType="local:DashboardPage"
             x:Class="daytoday.Views.DashboardPage"
             
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
             Title="Pulpit"
             x:Name="dashboardPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCard" TargetType="Border">
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,8"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}"/>
            </Style>

            <Style x:Key="HeaderIconContainer" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"/>
                <Setter Property="WidthRequest" Value="48"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            </Style>

            <Style x:Key="HeaderIcon" TargetType="Label">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style x:Key="SectionDescription" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                <Setter Property="LineBreakMode" Value="WordWrap"/>
                <Setter Property="MaxLines" Value="2"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatDescription" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=White}"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20">
        <VerticalStackLayout Grid.Row="0" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                <Border Grid.Row="0" Grid.Column="0" 
                       BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#4A148C}"
                       Style="{StaticResource HeaderIconContainer}">
                    <Label Text="🏠"
                          Style="{StaticResource HeaderIcon}"/>
                </Border>

                <VerticalStackLayout Grid.Row="0" Grid.Column="1" 
                                    Margin="16,0,0,0" 
                                    VerticalOptions="Center">
                    <Label Text="Pulpit" 
                          Style="{StaticResource SectionHeader}"/>
                    <Label Text="Witaj w Day To Day! Zarządzaj swoimi zadaniami i projektami" 
                          Style="{StaticResource SectionDescription}"/>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource DashboardCard}"
                       BackgroundColor="#37474F">
                    <Grid RowDefinitions="Auto,Auto" Padding="5">
                        <Label Text="Statystyki" 
                              Grid.Row="0"
                              TextColor="White" 
                              FontSize="18"
                              FontAttributes="Bold"
                              Margin="0,0,0,10"/>

                        <Grid Grid.Row="1" 
                             ColumnDefinitions="*,*" 
                             RowDefinitions="Auto,Auto" 
                             ColumnSpacing="15" 
                             RowSpacing="15">

                            <Border Grid.Row="0" Grid.Column="0"
                                  BackgroundColor="#607D8B"
                                  StrokeThickness="0"
                                  StrokeShape="RoundRectangle 10"
                                  Padding="15">
                                <VerticalStackLayout>
                                    <Label Text="✅" FontSize="28" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="{Binding CompletedTasksCount}" Style="{StaticResource StatLabel}"/>
                                    <Label Text="Ukończone zadania" Style="{StaticResource StatDescription}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1"
                                  BackgroundColor="#607D8B"
                                  StrokeThickness="0"
                                  StrokeShape="RoundRectangle 10"
                                  Padding="15">
                                <VerticalStackLayout>
                                    <Label Text="🔄" FontSize="28" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="{Binding InProgressTasksCount}" Style="{StaticResource StatLabel}"/>
                                    <Label Text="W trakcie" Style="{StaticResource StatDescription}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0"
                                  BackgroundColor="#607D8B"
                                  StrokeThickness="0"
                                  StrokeShape="RoundRectangle 10"
                                  Padding="15">
                                <VerticalStackLayout>
                                    <Label Text="📋" FontSize="28" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="{Binding ActiveTasksCount}" Style="{StaticResource StatLabel}"/>
                                    <Label Text="Aktywne zadania" Style="{StaticResource StatDescription}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1"
                                  BackgroundColor="#607D8B"
                                  StrokeThickness="0"
                                  StrokeShape="RoundRectangle 10"
                                  Padding="15">
                                <VerticalStackLayout>
                                    <Label Text="📁" FontSize="28" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="{Binding ProjectsCount}" Style="{StaticResource StatLabel}"/>
                                    <Label Text="Aktywne projekty" Style="{StaticResource StatDescription}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Label Text="Szybkie akcje" 
                      FontSize="18" 
                      FontAttributes="Bold" 
                      TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                      Margin="0,10,0,5"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" 
                           Text="Nowe zadanie" 
                           Style="{StaticResource ActionButton}"
                           BackgroundColor="#4CAF50"
                           ImageSource="add_task.png"
                           Clicked="GoToTasks"/>

                    <Button Grid.Column="1" 
                           Text="Kalendarz"
                           Style="{StaticResource ActionButton}"
                           BackgroundColor="#FF9800"
                           ImageSource="calendar.png"
                           Clicked="GoToCalendar"/>
                </Grid>

                <Label Text="Aktywne zadania" 
                      FontSize="18" 
                      FontAttributes="Bold" 
                      TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                      Margin="0,10,0,5"/>

                <Border Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="15">
                        <CollectionView ItemsSource="{Binding RecentTasks}"
                                       EmptyView="Brak aktywnych zadań">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:TaskDto">
                                    <StackLayout>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                                            <Border Grid.Column="0"
                                                  BackgroundColor="{Binding}"
                                                  WidthRequest="36" HeightRequest="36"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 10">
                                                
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                                                <Label Text="{Binding Title}"
                                                     FontAttributes="Bold"
                                                     FontSize="16"
                                                     TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                                <Label Text="{Binding Category, StringFormat='Kategoria: {0}'}"
                                                     FontSize="12"
                                                     TextColor="{StaticResource Gray500}"/>
                                            </VerticalStackLayout>

                                           
                                        </Grid>

                                        <BoxView HeightRequest="1" 
                                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Pokaż wszystkie zadania" 
                              BackgroundColor="Transparent" 
                              TextColor="{StaticResource Primary}"
                              HorizontalOptions="Center"
                              Clicked="GoToTasks"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Nadchodzące wydarzenia" 
                      FontSize="18" 
                      FontAttributes="Bold" 
                      TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                      Margin="0,10,0,5"/>

                <Border Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="15">
                        <CollectionView ItemsSource="{Binding UpcomingEvents}" 
                                       EmptyView="Brak nadchodzących wydarzeń">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:CalendarEventDto">
                                    <StackLayout>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                                            <Border Grid.Column="0"
                                                  BackgroundColor="{Binding}"
                                                  WidthRequest="36" HeightRequest="36"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 10">
                                                <Label Text="📅"
                                                     FontSize="18"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     TextColor="White"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                                                <Label Text="{Binding Name}"
                                                     FontAttributes="Bold"
                                                     FontSize="16"
                                                     TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                                <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                     FontSize="12"
                                                     TextColor="{StaticResource Gray500}"/>
                                                <Label Text="{Binding Location}"
                                                     FontSize="12"
                                                     TextColor="{StaticResource Gray500}"
                                                     IsVisible="{Binding Location}"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" 
                                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Pokaż kalendarz" 
                              BackgroundColor="Transparent" 
                              TextColor="{StaticResource Primary}"
                              HorizontalOptions="Center"
                              Clicked="GoToCalendar"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator Grid.Row="1" 
                          IsRunning="{Binding IsBusy}" 
                          IsVisible="{Binding IsBusy}" 
                          HorizontalOptions="Center" 
                          VerticalOptions="Center"
                          Scale="1.5"/>
    </Grid>
</ContentPage>
