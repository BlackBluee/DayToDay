<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="daytoday.Views.LoginPage"
             Title="Logowanie"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ContentPage.Content>
        <Grid Padding="30" RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,40,0,20" HorizontalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#4A148C}"
                        WidthRequest="64" HeightRequest="64"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                    <Label Text="🔒"
                           FontSize="32"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                </Border>
                <Label Text="Zaloguj się do Day To Day"
                       Style="{StaticResource SectionHeader}"
                       HorizontalOptions="Center"/>
                <Label Text="Wprowadź swoje dane, aby kontynuować"
                       Style="{StaticResource SectionDescription}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="18">
                <Entry x:Name="emailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       HeightRequest="48"
                       Margin="0,0,0,5"/>
                <Entry x:Name="passwordEntry"
                       Placeholder="Hasło"
                       IsPassword="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       HeightRequest="48"
                       Margin="0,0,0,5"/>
                <Label x:Name="errorLabel"
                       TextColor="Red"
                       IsVisible="False"
                       FontSize="14"
                       HorizontalOptions="Center"/>
                <Button Text="Zaloguj"
                        Style="{StaticResource ActionButton}"
                        BackgroundColor="{StaticResource Primary}"
                        Clicked="OnLoginClicked"/>
            </VerticalStackLayout>

            <Label Grid.Row="2"
                   Text="Nie masz konta? Skontaktuj się z administratorem."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                   HorizontalOptions="Center"
                   Margin="0,30,0,0"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
